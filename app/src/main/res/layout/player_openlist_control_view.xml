<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 顶部标题栏 -->
    <LinearLayout
        android:id="@+id/openlistTopRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@android:color/transparent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/vs_40"
        android:paddingTop="@dimen/vs_20"
        android:paddingRight="@dimen/vs_40"
        android:paddingBottom="@dimen/vs_20"
        android:visibility="gone">

        <TextView
            android:id="@+id/openlistPlayTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@android:color/white"
            android:textSize="@dimen/ts_26"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />
    </LinearLayout>

    <!-- 中间 loading -->
    <ProgressBar
        android:id="@+id/openlistLoading"
        android:layout_width="@dimen/vs_60"
        android:layout_height="@dimen/vs_60"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- 中间暂停图标 -->
    <ImageView
        android:id="@+id/openlistPauseIcon"
        android:layout_width="@dimen/vs_80"
        android:layout_height="@dimen/vs_80"
        android:layout_gravity="center"
        android:alpha="0.85"
        android:src="@drawable/icon_play"
        android:visibility="gone" />

    <!-- 底部控制条:功能按钮行 + 进度条行 -->
    <LinearLayout
        android:id="@+id/openlistBottomRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@android:color/transparent"
        android:orientation="vertical"
        android:paddingLeft="@dimen/vs_40"
        android:paddingTop="@dimen/vs_15"
        android:paddingRight="@dimen/vs_40"
        android:paddingBottom="@dimen/vs_15"
        android:visibility="gone">

        <!-- 功能按钮行 -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/vs_15"
            android:fillViewport="false"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/openlistBtnGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/openlistPlayNext"
                    android:singleLine="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/vs_5"
                    android:layout_marginRight="@dimen/vs_5"
                    android:background="@drawable/button_dialog_main"
                    android:focusable="true"
                    android:padding="@dimen/vs_10"
                    android:text="下一集"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/ts_20" />

                <TextView
                    android:id="@+id/openlistPlayPre"
                    android:singleLine="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/vs_5"
                    android:layout_marginRight="@dimen/vs_5"
                    android:background="@drawable/button_dialog_main"
                    android:focusable="true"
                    android:padding="@dimen/vs_10"
                    android:text="上一集"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/ts_20" />

                <TextView
                    android:id="@+id/openlistPlayRetry"
                    android:singleLine="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/vs_5"
                    android:layout_marginRight="@dimen/vs_5"
                    android:background="@drawable/button_dialog_main"
                    android:focusable="true"
                    android:padding="@dimen/vs_10"
                    android:text="重播"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/ts_20" />

                <TextView
                    android:id="@+id/openlistPlayRefresh"
                    android:singleLine="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/vs_5"
                    android:layout_marginRight="@dimen/vs_5"
                    android:background="@drawable/button_dialog_main"
                    android:focusable="true"
                    android:padding="@dimen/vs_10"
                    android:text="刷新"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/ts_20" />

                <TextView
                    android:id="@+id/openlistPlayPlayer"
                    android:singleLine="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/vs_5"
                    android:layout_marginRight="@dimen/vs_5"
                    android:background="@drawable/button_dialog_main"
                    android:focusable="true"
                    android:padding="@dimen/vs_10"
                    android:text="默认"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/ts_20"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/openlistPlaySpeed"
                    android:singleLine="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/vs_5"
                    android:layout_marginRight="@dimen/vs_5"
                    android:background="@drawable/button_dialog_main"
                    android:focusable="true"
                    android:padding="@dimen/vs_10"
                    android:text="x1.0"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/ts_20" />

                <TextView
                    android:id="@+id/openlistDanmuSetting"
                    android:singleLine="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/vs_5"
                    android:layout_marginRight="@dimen/vs_5"
                    android:background="@drawable/button_dialog_main"
                    android:focusable="true"
                    android:padding="@dimen/vs_10"
                    android:text="弹幕"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/ts_20" />

                <TextView
                    android:id="@+id/openlistDanmuSearch"
                    android:singleLine="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/vs_5"
                    android:layout_marginRight="@dimen/vs_5"
                    android:background="@drawable/button_dialog_main"
                    android:focusable="true"
                    android:padding="@dimen/vs_10"
                    android:text="云搜"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/ts_20" />

            </LinearLayout>
        </HorizontalScrollView>

        <!-- 进度条行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/openlistCurTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_20"
                tools:text="00:00" />

            <SeekBar
                android:id="@+id/openlistSeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/vs_15"
                android:layout_marginRight="@dimen/vs_15"
                android:layout_weight="1"
                android:focusable="false"
                android:max="1000"
                android:maxHeight="@dimen/vs_4"
                android:minHeight="@dimen/vs_4"
                android:progressTint="@color/color_FF5F00"
                android:thumbTint="@color/color_FF5F00" />

            <TextView
                android:id="@+id/openlistTotalTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_20"
                tools:text="00:00" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
