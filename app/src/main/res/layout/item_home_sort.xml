<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/vs_45"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="horizontal"
    android:paddingLeft="@dimen/vs_20"
    android:paddingRight="@dimen/vs_20">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:focusable="false"
        android:gravity="center"
        android:textColor="@color/color_BBFFFFFF"
        android:textSize="@dimen/ts_30" />

    <!-- 分类文字右边的筛选图标（漏斗）已按需求去掉，只保留文字。
         tvFilter / tvFilterColor 这两个 id 仍保留在代码里（HomeActivity 会 findViewById 并置可见性），
         为了不改动筛选功能本身的逻辑，这里改成 0dp 不可见的占位 View，而不是直接删掉 id 引发崩溃。 -->
    <View
        android:id="@+id/tvFilter"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <View
        android:id="@+id/tvFilterColor"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</LinearLayout>
