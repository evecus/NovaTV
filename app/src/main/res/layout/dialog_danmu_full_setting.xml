<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="@dimen/vs_600"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/shape_danmu_setting_bg"
        android:orientation="vertical"
        android:paddingLeft="@dimen/vs_30"
        android:paddingTop="@dimen/vs_28"
        android:paddingRight="@dimen/vs_30"
        android:paddingBottom="@dimen/vs_28">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/vs_20"
            android:gravity="center"
            android:text="弹幕设置"
            android:textColor="@color/dialog_text_primary"
            android:textSize="@dimen/ts_24"
            android:textStyle="bold" />

        <!-- 开关 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/vs_16"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="@dimen/vs_110"
                android:layout_height="wrap_content"
                android:text="开关"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_20" />

            <LinearLayout
                android:id="@+id/llSwitchOptions"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal" />
        </LinearLayout>

        <!-- 速度 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/vs_16"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="@dimen/vs_110"
                android:layout_height="wrap_content"
                android:text="速度"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_20" />

            <LinearLayout
                android:id="@+id/llSpeedOptions"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal" />
        </LinearLayout>

        <!-- 字号 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/vs_16"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="@dimen/vs_110"
                android:layout_height="wrap_content"
                android:text="字号"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_20" />

            <include
                android:id="@+id/stepperSize"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                layout="@layout/item_danmu_stepper" />
        </LinearLayout>

        <!-- 行数 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/vs_16"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="@dimen/vs_110"
                android:layout_height="wrap_content"
                android:text="行数"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_20" />

            <include
                android:id="@+id/stepperLine"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                layout="@layout/item_danmu_stepper" />
        </LinearLayout>

        <!-- 透明度 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/vs_16"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="@dimen/vs_110"
                android:layout_height="wrap_content"
                android:text="透明度"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_20" />

            <include
                android:id="@+id/stepperAlpha"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                layout="@layout/item_danmu_stepper" />
        </LinearLayout>

        <!-- 行间距 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/vs_16"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="@dimen/vs_110"
                android:layout_height="wrap_content"
                android:text="行间距"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_20" />

            <include
                android:id="@+id/stepperLineSpacing"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                layout="@layout/item_danmu_stepper" />
        </LinearLayout>

        <!-- 顶边距 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="@dimen/vs_110"
                android:layout_height="wrap_content"
                android:text="顶边距"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_20" />

            <include
                android:id="@+id/stepperTopMargin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                layout="@layout/item_danmu_stepper" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
