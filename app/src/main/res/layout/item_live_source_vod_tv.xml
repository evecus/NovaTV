<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginBottom="@dimen/vs_8">

    <!--
        点播源自带的 lives 线路：只读展示，可点击切换，但不提供编辑/删除按钮
        （这些线路来自点播源 JSON 本身，不是用户手动添加的，不应被改动）。
    -->
    <TextView
        android:id="@+id/tvName"
        android:layout_width="@dimen/vs_0"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_gravity="center_vertical"
        android:background="@drawable/button_danmu_setting"
        android:clickable="true"
        android:focusable="true"
        android:ellipsize="end"
        android:gravity="center"
        android:padding="@dimen/vs_10"
        android:singleLine="true"
        android:textColor="@color/dialog_text_primary"
        android:textSize="@dimen/ts_24" />

    <TextView
        android:id="@+id/tvVodTag"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/vs_5"
        android:layout_marginLeft="@dimen/vs_5"
        android:layout_gravity="center_vertical"
        android:gravity="center"
        android:minWidth="@dimen/vs_50"
        android:paddingLeft="@dimen/vs_10"
        android:paddingRight="@dimen/vs_10"
        android:text="点播自带"
        android:textColor="#88FFFFFF"
        android:textSize="@dimen/ts_16" />

</LinearLayout>
